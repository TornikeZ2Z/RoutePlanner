# Non-secret production configuration. Committed on purpose: every value here
# is either public (company registration, support address) or a switch whose
# state should be reviewable in git history. Secrets live in Vault and arrive
# through /secrets/app/app.env. Never add one here.
#
# Used twice: by compose as env_file for the app container, and sourced by
# the Dockerfile during `next build`, because canonical URLs, the CSP and the
# legal pages are prerendered from these values.

APP_URL=https://routeplanner.ge
# Both are safe to leave on: routeplanner.ge is verified and serving. The
# onrender.com rule behind ENFORCE_CANONICAL_HOST is dead on-premise.
REDIRECT_FORMER_DOMAIN=true
ENFORCE_CANONICAL_HOST=false

# ---- Object storage: Garage on the backend network -------------------------
STORAGE_DRIVER=s3
S3_BUCKET=routeplanner-files
S3_ENDPOINT=http://garage:3900
S3_REGION=garage

# ---- Contracting entity (printed into every agreement) ---------------------
COMPANY_LEGAL_NAME='შპს „რაუტ ჯორჯია“ / ROUTE GEORGIA LLC'
COMPANY_ID_NUMBER=437377704
# Still the generic address (HANDOVER.md section 12, item 2). Replace with the
# registered street address before volume.
COMPANY_ADDRESS='თბილისი, საქართველო / Tbilisi, Georgia'

# ---- Public contact ---------------------------------------------------------
SUPPORT_EMAIL=support@routeplanner.ge
# Empty hides the phone from header and footer. Set when the business SIM exists.
SUPPORT_PHONE=

# ---- Mail: Google Workspace over SMTP (password comes from Vault) ------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=info@routeplanner.ge
MAIL_FROM='Route Planner <info@routeplanner.ge>'

# ---- SMS: smsoffice.ge (key comes from Vault) -------------------------------
# WITH the space. This is the name smsoffice.ge registered and approved; the
# stripped form "RoutePlan" is refused with error 150 on every send
# (HANDOVER.md section 8). Max 11 chars.
SMSOFFICE_SENDER='Route Plan'

# ---- Routing ----------------------------------------------------------------
ROUTING_PROVIDER=osrm

# ---- Marketplace policy (fallbacks; live values are in platform_settings) ---
COMMISSION_RATE_BPS=1500
CANONICAL_CURRENCY=GEL
PRICE_ROUNDING_STEP_MINOR=50
QUOTE_TTL_SECONDS=900
HOLD_TTL_SECONDS=600
DRIVER_ACK_SLA_MINUTES=10
CHILD_SEAT_FEE_MINOR=2000
