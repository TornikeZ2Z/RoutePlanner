# Original photo drops stay local; only the web crops in public/photos ship.
/Photoes/

# Photo import bundles — processed crops live in public/photos
routeplanner-photos*.zip
wetransfer_*.zip

# Screenshots pulled from change requests. Restricted: they show customer data.
/.request-images/

# Throwaway probes and workflow output. These are written next to the project
# because path aliases only resolve here, and `git add -A` swept three of them
# into a commit before this rule existed.
/.[a-z].mjs
/scratch_*

# On-premise deploy state written by deploy/scripts/deploy.sh (current image tag).
/deploy/.env
/deploy/.env.previous

# Per-machine Claude Code permissions (the server copies deploy/claude/settings.json here).
/.claude/settings.local.json
